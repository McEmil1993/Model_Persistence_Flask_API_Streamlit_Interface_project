    "name": "Student Pass API (Exercise 2)",
    "description": "Start the API first with: python app.py",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Valid (6 hours, 90% attendance)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response has both inputs, the prediction and the probability\", function () { pm.expect(pm.response.json()).to.have.keys(\"study_hours\",\"attendance_percentage\",\"prediction\",\"pass_probability\"); });",
              "pm.test(\"Prediction is Pass\", function () { pm.expect(pm.response.json().prediction).to.eql(\"Pass\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"study_hours\": 6,\n  \"attendance_percentage\": 90\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/predict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict"
          ]
        }
      },
      "response": []
    },
